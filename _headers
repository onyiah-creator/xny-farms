# Cloudflare Pages security & caching headers.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'

# Long-cache static assets (they are versioned by content / rarely change)
/assets/*
  Cache-Control: public, max-age=86400

# Short-cache + forced revalidation for CSS/JS — these are actively
# iterated on, and a stale edge/browser cache of these specifically was
# masking deploys for up to 24h under the old max-age=86400 rule.
/css/*
  Cache-Control: public, max-age=300, must-revalidate
/js/*
  Cache-Control: public, max-age=300, must-revalidate

# Admin pages: never cached (by a browser, a shared computer or an edge), kept out of search indexes, never
# framed, and never leaking their URL. The "!" lines detach the site-wide value first: without them Cloudflare
# JOINS both values with a comma ("SAMEORIGIN, DENY"), which browsers treat as invalid.
# (The admin API responses get the same headers from functions/api/_middleware.js, because _headers is not
# applied to Functions responses.) X-Content-Type-Options: nosniff comes from the site-wide rule above.
# Internal referral report — keep it out of search indexes entirely.
# (admin-referrals.html also carries a noindex meta tag.)
/admin-referrals.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  ! X-Frame-Options
  ! Referrer-Policy
  ! Content-Security-Policy
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
