# Cloudflare Pages security & caching headers.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'

# Long-cache static assets (they are versioned by content / rarely change)
/assets/*
  Cache-Control: public, max-age=86400

# Short-cache + forced revalidation for CSS/JS — these are actively
# iterated on, and a stale edge/browser cache of these specifically was
# masking deploys for up to 24h under the old max-age=86400 rule.
/css/*
  Cache-Control: public, max-age=300, must-revalidate
/js/*
  Cache-Control: public, max-age=300, must-revalidate

# Admin pages: never cached (by a browser, a shared computer or an edge), and kept out of search indexes.
# Internal referral report — keep it out of search indexes entirely.
# (admin-referrals.html also carries a noindex meta tag.)
/admin-referrals.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
/admin-pricing.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
/admin-approve-affiliate.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
/admin.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
/affiliate-confirmed.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  Referrer-Policy: no-referrer
